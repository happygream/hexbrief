{
  "name": "hexbrief",
  "version": "1.0.1",
  "description": "Your personal morning dashboard",
  "author": {
    "name": "HexBrief",
    "email": "hello@hexbrief.co"
  },
  "homepage": "https://hexbrief.co",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "export": "next build && next export",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder",
    "electron:build:win": "next build && electron-builder --win --publish never",
    "electron:build:mac": "next build && electron-builder --mac --publish never",
    "electron:build:linux": "next build && electron-builder --linux --publish never",
    "dist": "next build && electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "co.hexbrief.app",
    "productName": "HexBrief",
    "copyright": "Copyright 2026 HexBrief",
    "asar": true,
    "asarUnpack": [
      "out/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      },
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HexBrief",
      "uninstallDisplayName": "HexBrief",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "deleteAppDataOnUninstall": true,
      "menuCategory": "HexBrief",
      "script": "build-resources/hexbrief-installer.nsi",
      "warningsAsErrors": false,
      "artifactName": "HexBrief-Setup-${version}-${arch}.exe",
      "installerLanguages": ["en_US"],
      "language": "1033"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build-resources/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "artifactName": "HexBrief-${version}-${arch}-mac.zip"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.png",
      "category": "Utility",
      "description": "Your personal morning dashboard",
      "artifactName": "HexBrief-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "happygream",
      "repo": "hexbrief",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-pwa": "^5.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  }
}